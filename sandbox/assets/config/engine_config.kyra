{
    "info": {
        "author": "Jennifer (MapleMaiden2000)",
        "version": "0.1.0"
    },
    
    "log_system": {
        "out_directory": "out/logs",
        "loggers": [
            { "id": "KYRA_ENGINE", "file": "engine.log", "flags": "ALL" },
            { "id": "KYRA_EDITOR", "file": "editor.log", "flags": "ALL" }
        ]
    },

    "memory": {
        "zones": {
            "string": "4 MB",
            "containers": "12 MB",
            "delegates": "1 MB",
            "loggers": "64 KB",
            "platform": "64 KB",
            "input": "32 KB",
            "command": "256 KB",
            "editor": "128 KB"
        }
    },

    "command": {
        "history_limit": 20,
        "undo_limit": 25,
        "echo_prompt": true,
        "max_arguments": 16,
        "token_max_length": 256
    }
}
